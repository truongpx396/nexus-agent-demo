meta {
  name: Grant approval
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/approvals/{{approvalId}}/grant
  body: none
  auth: inherit
}

assert {
  res.status: eq 202
  res.body.approval_id: isString
  res.body.session_id: isString
  res.body.status: isString
}

docs {
  Approves the tool call as proposed. The decision is recorded before the answer is sent, and the suspended run then resumes on a queue worker, so the answer is `202` with `{"approval_id", "session_id", "status"}`. `status` is `resuming` once the run is queued, or `decided` if the hand-off to the queue failed (the decision stands and recovery resumes the run). Follow `Stream run events (SSE)`, or ask `Get run` whether it is done.

  `404` for an approval that is not there, and `409` for one that is no longer pending.
}
