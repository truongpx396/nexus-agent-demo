meta {
  name: Deny approval
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/approvals/{{approvalId}}/deny
  body: json
  auth: inherit
}

body:json {
  {
    "reason": "not what I asked for"
  }
}

assert {
  res.status: eq 202
  res.body.approval_id: isString
  res.body.session_id: isString
  res.body.status: isString
}

docs {
  Refuses the tool call. `reason` is optional, and so is the whole body. Like `Grant approval`, it answers `202` with `{"approval_id", "session_id", "status"}` once the decision is recorded, and the run resumes on a queue worker to end under `permission_denied`. `404` and `409` as for a grant.
}
