meta {
  name: Metrics
  type: http
  seq: 3
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/metrics
  body: none
  auth: bearer
}

auth:bearer {
  token: {{metricsToken}}
}

assert {
  res.status: eq 200
}

docs {
  Per-tenant golden signals, with per-tool and per-model breakdowns, in Prometheus text format. Needs the server's static metrics token (NEXUS_METRICS_TOKEN, set as the metricsToken environment secret), not a tenant token. Under --dev with no token configured it is open and any value of metricsToken works.
}
